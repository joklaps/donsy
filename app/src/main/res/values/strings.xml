    <string name="notification_channel_focus_description">Shows the time left while a focus session runs.</string>
    <!-- Notification channel (Android settings) for the end of a session. -->
    <string name="notification_channel_focus_end">Focus session ended</string>
    <!-- Description of the session-ended notification channel. -->
    <string name="notification_channel_focus_end_description">Lets you know when a focus session is over.</string>
    <!-- Running-timer notification title. %1$s = step or task title. -->
    <string name="notification_focus_running_title">Focusing: %1$s</string>
    <!-- Running-timer notification title without a task. -->
    <string name="notification_focus_running_plain">Focusing</string>
    <!-- Paused-timer notification text. %d = minutes left. -->
    <plurals name="notification_focus_paused">
        <item quantity="one">Paused · %d minute left</item>
        <item quantity="other">Paused · %d minutes left</item>
    </plurals>
    <!-- Notification when a session's time is up: title. -->
    <string name="notification_focus_done_title">Focus session complete</string>
    <!-- Notification when a session's time is up: text. -->
    <string name="notification_focus_done_text">Nice work. Tap to see how it went.</string>

    <!-- Settings: switch for exact end-of-session alarms. -->
    <string name="settings_precise_alerts">Precise end alerts</string>
    <!-- Settings: explanation of precise end alerts. -->
    <string name="settings_precise_alerts_body">Alert at the exact moment a focus session ends. Android asks for your permission. Without it, the alert can come several minutes late.</string>
    <!-- Settings: which session lengths the Focus screen offers. Also the dialog title. -->
    <string name="settings_focus_lengths">Focus lengths</string>
    <!-- Settings dialog: explanation above the list of lengths (5 min, 10 min, …). -->
    <string name="settings_focus_lengths_body">Choose the lengths you want to pick from on the Focus screen.</string>
    <!-- Settings: the session length that is selected when the Focus screen opens. Also the dialog title. -->
    <string name="settings_focus_default">Preselected length</string>
    <!-- Focus set-up card, asked once: offer exact end-of-session alerts. -->
    <string name="focus_precise_offer_title">Get the end alert right on time?</string>
    <!-- Focus set-up card: why permission is needed. -->
    <string name="focus_precise_offer_body">Without your permission, Android can send it a few minutes late. You can change this later in Settings.</string>
    <!-- Button: give the permission. -->
    <string name="action_allow">Allow</string>
    <!-- Button: decline politely. -->
    <string name="action_no_thanks">No thanks</string>

    <!-- Tasks list section with tasks that repeat on set days. -->
    <string name="tasks_section_routines">Routines (repeating)</string>
    <!-- Tasks tab: short help under the routines heading, shown after tapping its ?. Never "missed". -->
    <string name="tasks_section_routines_help">Tasks that come back on set days. Tick them off for today.</string>
    <!-- Status of a routine that was ticked off today; it comes back on its next day. -->
    <string name="routine_status_done_today">Done for today</string>
    <!-- Button on a routine's detail screen: mark it done for today. -->
    <string name="action_routine_done_today">Done for today</string>
    <!-- Button on a routine's detail screen after it was marked done today: take that back. -->
    <string name="action_routine_not_done">Not done yet</string>
    <!-- Accessibility label of a routine's checkbox. %1$s = routine title. -->
    <string name="action_routine_done_named">Mark %1$s done for today</string>
    <!-- Accessibility label of a ticked routine's checkbox. %1$s = routine title. -->
    <string name="action_routine_undo_named">Mark %1$s not done yet</string>
    <!-- Shown when making a routine without the needed permissions. Calm, factual. -->
    <string name="reminders_permission_body">Routines remind you at the time you choose. For that, Donsy needs to send notifications and set alarms.</string>
    <!-- Shown above the routines when a needed permission was switched off later. -->
    <string name="reminders_off_body">Reminders for your routines are off. Allow them so Donsy can remind you on time.</string>
    <!-- Button: ask for (or open the settings for) notifications. -->
    <string name="action_allow_notifications">Allow notifications</string>
    <!-- Button: open Android's "Alarms &amp; reminders" setting for Donsy. -->
    <string name="action_allow_alarms">Allow alarms</string>
    <!-- Notification channel name (Android settings) for routine reminders. -->
    <string name="notification_channel_routines">Routines</string>
    <!-- Notification channel description (Android settings). -->
    <string name="notification_channel_routines_description">A reminder at the time you chose for a routine.</string>
    <!-- Text of a routine reminder; the title is the routine itself. %1$s = time. Kind, no pressure. -->
    <string name="notification_routine_text">It\'s %1$s: time for this routine.</string>
    <!-- Action button on a routine reminder: mark the routine done for today. Keep very short. -->
    <string name="action_routine_done">Done</string>

    <!-- ===== Data safety: Settings, export/restore, Recently deleted, Archive ===== -->
    <!-- Settings: heading band above language, focus and alert settings. -->
    <string name="settings_section_general">General</string>
    <!-- Settings: heading band above export, restore, recently deleted and archive. -->
    <string name="settings_section_data">Your data</string>
    <!-- Settings, under "Your data": why exporting matters. Calm and factual, no scare tone. -->
    <string name="settings_data_local_only">Everything stays on this phone. If you uninstall Donsy or switch phones, it\'s gone unless you export it first.</string>
    <!-- Settings item: save everything to a file. -->
    <string name="settings_export">Export your data</string>
    <!-- Settings item explanation for exporting. -->
    <string name="settings_export_body">Save your tasks, routines, thoughts, focus history and settings to a file.</string>
    <!-- Settings item: load an export file. -->
    <string name="settings_restore">Restore from a file</string>
    <!-- Settings item explanation for restoring. -->
    <string name="settings_restore_body">Replace everything in Donsy with an export.</string>
    <!-- Settings item: list of deleted tasks and thoughts that can still be restored. -->
    <string name="settings_recently_deleted">Recently deleted</string>
    <!-- Settings item explanation for recently deleted. -->
    <string name="settings_recently_deleted_body">Deleted tasks and thoughts, kept for 7 days.</string>
    <!-- Settings item: list of archived (put away) done tasks. -->
    <string name="settings_archive">Archive</string>
    <!-- Settings item explanation for the archive. -->
    <string name="settings_archive_body">Done tasks you put away. Bring any of them back.</string>
    <!-- Settings item: how long done tasks stay in the list before moving to the archive by themselves. -->
    <string name="settings_auto_archive">Archive done tasks automatically</string>
    <!-- Choice for automatic archiving: never. -->
    <string name="settings_auto_archive_never">Never</string>
    <!-- Choice for automatic archiving. %d = number of days a done task is left alone first. -->
    <plurals name="settings_auto_archive_after">
        <item quantity="one">After %d day</item>
        <item quantity="other">After %d days</item>
    </plurals>
    <!-- Screen-reader text for the progress bar while exporting or restoring. -->
    <string name="backup_working">Working on your data…</string>

    <!-- Export dialog: title. -->
    <string name="export_title">Export your data</string>
    <!-- Export dialog: what is saved. -->
    <string name="export_body">Saves your tasks, routines, thoughts, focus history and settings to a file you choose.</string>
    <!-- Export dialog: switch to encrypt the file. -->
    <string name="export_protect">Protect with a passphrase</string>
    <!-- Export dialog, without a passphrase: honest warning. -->
    <string name="export_plain_warning">Without a passphrase, anyone who gets the file can read it. Keep it somewhere safe.</string>
    <!-- Label of the passphrase field (export and restore). -->
    <string name="export_passphrase">Passphrase</string>
    <!-- Label of the field to type the passphrase a second time. -->
    <string name="export_passphrase_repeat">Repeat passphrase</string>
    <!-- Export dialog: rules and consequence of forgetting. -->
    <string name="export_passphrase_rule">At least 8 characters. If you forget it, nobody can open the file, not even Donsy.</string>
    <!-- Export dialog: the two passphrases are not the same. -->
    <string name="export_passphrase_mismatch">The two passphrases are different.</string>
    <!-- Export dialog: confirm button. -->
    <string name="action_export">Export</string>

    <!-- Restore: title of the dialog asking for the passphrase of a protected file. -->
    <string name="restore_passphrase_title">This file is protected</string>
    <!-- Restore: explanation in the passphrase dialog. -->
    <string name="restore_passphrase_body">Type the passphrase you chose when you exported it.</string>
    <!-- Restore: shown under the field after a wrong passphrase. -->
    <string name="restore_passphrase_wrong">That passphrase doesn\'t open this file. Try again.</string>
    <!-- Restore: button to open the protected file with the passphrase. -->
    <string name="action_open_file">Open</string>
    <!-- Restore: title of the confirmation dialog. -->
    <string name="restore_confirm_title">Replace everything?</string>
    <!-- Restore: when the export was made. %1$s = date, %2$s = time. -->
    <string name="restore_confirm_made">Exported on %1$s at %2$s.</string>
    <!-- Restore: introduces the list of counts below it. -->
    <string name="restore_confirm_contains">This file holds:</string>
    <!-- One line in a bulleted list. %1$s = the line's text. -->
    <string name="list_bullet">• %1$s</string>
    <!-- Restore: count of tasks in the file. -->
    <plurals name="restore_count_tasks">
        <item quantity="one">%d task</item>
        <item quantity="other">%d tasks</item>
    </plurals>
    <!-- Restore: count of routines in the file. -->
    <plurals name="restore_count_routines">
        <item quantity="one">%d routine</item>
        <item quantity="other">%d routines</item>
    </plurals>
    <!-- Restore: count of BrainDump thoughts in the file. -->
    <plurals name="restore_count_thoughts">
        <item quantity="one">%d thought</item>
        <item quantity="other">%d thoughts</item>
    </plurals>
    <!-- Restore: count of past focus sessions in the file. -->
    <plurals name="restore_count_focus_sessions">
        <item quantity="one">%d focus session</item>
        <item quantity="other">%d focus sessions</item>
    </plurals>
    <!-- Restore: count of recently deleted tasks and thoughts in the file. -->
    <plurals name="restore_count_recently_deleted">
        <item quantity="one">%d recently deleted item</item>
        <item quantity="other">%d recently deleted items</item>
    </plurals>
    <!-- Restore: plain warning before replacing. -->
    <string name="restore_confirm_warning">Everything now in Donsy is replaced by what\'s in this file. This can\'t be undone.</string>
    <!-- Restore: confirm button. -->
    <string name="action_replace_everything">Replace everything</string>

    <!-- Snackbar after a successful export. -->
    <string name="backup_exported">Export saved</string>
    <!-- Snackbar when the export file couldn't be written. -->
    <string name="backup_export_failed">Couldn\'t save the file. Try another place.</string>
    <!-- Snackbar after a successful restore. -->
    <string name="backup_restored">Everything is restored</string>
    <!-- Snackbar when the chosen file can't be read at all. -->
    <string name="backup_unreadable">Couldn\'t open that file</string>
    <!-- Snackbar when the chosen file is not a Donsy export. -->
    <string name="backup_not_a_backup">That file isn\'t a Donsy export</string>
    <!-- Snackbar when the export was made by a newer version of the app. -->
    <string name="backup_from_newer_version">That export comes from a newer Donsy. Update the app first.</string>
    <!-- Snackbar when a focus session is running or paused during a restore. -->
    <string name="backup_focus_session_active">Finish or stop your focus session first, then restore.</string>

    <!-- Recently deleted screen: title. -->
    <string name="recently_deleted_title">Recently deleted</string>
    <!-- Recently deleted screen: explanation at the top. -->
    <string name="recently_deleted_intro">Deleted tasks and thoughts stay here for 7 days. After that they\'re gone for good.</string>
    <!-- Recently deleted screen: heading band above deleted tasks. -->
    <string name="recently_deleted_section_tasks">Tasks</string>
    <!-- Recently deleted screen: heading band above deleted BrainDump thoughts. -->
    <string name="recently_deleted_section_thoughts">Thoughts</string>
    <!-- Recently deleted screen: shown when nothing was deleted recently. -->
    <string name="recently_deleted_empty">Nothing deleted recently.</string>
    <!-- Recently deleted row: how long the item is still kept. %d = days. -->
    <plurals name="recently_deleted_days_left">
        <item quantity="one">Kept for %d more day</item>
        <item quantity="other">Kept for %d more days</item>
    </plurals>
    <!-- Button on a deleted item: bring it back. -->
    <string name="action_restore">Restore</string>
    <!-- Screen-reader label of the restore button. %1$s = task title or first line of the thought. -->
    <string name="action_restore_named">Restore “%1$s”</string>
    <!-- Screen-reader label of the delete-for-good icon button. %1$s = task title or first line of the thought. -->
    <string name="action_delete_forever_named">Delete “%1$s” for good</string>
    <!-- Confirm button: delete for good. -->
    <string name="action_delete_forever">Delete for good</string>
    <!-- Title of the confirmation before deleting for good. -->
    <string name="delete_forever_title">Delete for good?</string>
    <!-- Body of the confirmation before deleting for good. %1$s = task title or first line of the thought. -->
    <string name="delete_forever_body">“%1$s” can\'t be brought back after this.</string>
    <!-- Snackbar after restoring a task. -->
    <string name="recently_deleted_restored_task">Back in your tasks</string>
    <!-- Snackbar after restoring a thought. -->
    <string name="recently_deleted_restored_thought">Back in your Brain Dump</string>

    <!-- Archive screen: title. -->
    <string name="archive_title">Archive</string>
    <!-- Archive screen: explanation at the top. -->
    <string name="archive_intro">Done tasks you put away, by hand or automatically. Bring one back to see it under Done again.</string>
    <!-- Archive screen: shown when the archive is empty. -->
    <string name="archive_empty">No archived tasks yet.</string>
    <!-- Archive row: when the task was done. %1$s = date, e.g. "3 Oct". -->
    <string name="archive_done_on">Done %1$s</string>
    <!-- Archive row button: move the task back to the Done section. -->
    <string name="action_bring_back">Bring back</string>
    <!-- Screen-reader label of the bring-back button. %1$s = task title. -->
    <string name="action_bring_back_named">Bring back “%1$s”</string>
    <!-- Snackbar after bringing a task back from the archive; offered with Undo. -->
    <string name="archive_brought_back">Back under Done</string>
    <!-- Screen-reader label of the archive icon on a done task in the Tasks list. %1$s = task title. -->
    <string name="action_archive_named">Archive “%1$s”</string>
    <!-- Snackbar after archiving a done task from the Tasks list; offered with Undo. -->
    <string name="task_archived">Task archived</string>

    <!-- Settings: heading of the last section, about the app itself. -->
    <string name="settings_section_about">About Donsy</string>
