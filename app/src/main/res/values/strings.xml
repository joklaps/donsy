    <plurals name="focus_done_body">
        <item quantity="one">You focused for %d minute.</item>
        <item quantity="other">You focused for %d minutes.</item>
    </plurals>
    <!-- After a session that ran out while the app was closed. -->
    <string name="focus_note_finished_away">It finished while you were away.</string>
    <!-- After a session that stayed paused very long and was ended automatically. -->
    <string name="focus_note_long_pause">It was paused for a long time, so it has been wrapped up.</string>
    <!-- After a session: offer to check off what was worked on. %1$s = step or task title. -->
    <string name="focus_mark_done_question">Mark “%1$s” done?</string>
    <!-- After a session, once the step or task is checked off. -->
    <string name="focus_marked_done">Checked off. Nice work.</string>
