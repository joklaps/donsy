        <item quantity="one">%1$d of %2$d step</item>
        <item quantity="other">%1$d of %2$d steps</item>
    </plurals>

    <!-- Due date, today. Neutral wording, no urgency. -->
    <string name="due_today">Due today</string>
    <!-- Due date, tomorrow. -->
    <string name="due_tomorrow">Due tomorrow</string>
    <!-- Due date later. %1$s = weekday ("Friday") or short date ("3 Nov"). -->
    <string name="due_on">Due %1$s</string>
