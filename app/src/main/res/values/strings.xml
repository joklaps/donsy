    <string name="action_resume">Resume</string>
    <!-- Ends the session now and counts the time spent. -->
    <string name="action_finish_early">Finish now</string>
    <!-- Ends the session without counting it. -->
    <string name="action_cancel_session">Cancel session</string>
    <!-- Reassurance under the session buttons: ending a session never completes or changes the task. -->
    <string name="focus_task_unchanged">Stopping never changes your task. You decide when it\'s done.</string>

    <!-- After a session that ran its full time: heading. -->
    <string name="focus_done_title">Session complete</string>
    <!-- After a session that was finished early: heading. Not a failure. -->
    <string name="focus_ended_title">Session ended</string>
