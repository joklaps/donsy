<?xml version="1.0" encoding="utf-8"?>
<!--
    Built-in breakdown templates (docs/spec.md, "Breakdown templates").

    Per template:
    - *_name: shown in the template list and above the step preview.
    - *_keywords: words in a task title or notes that suggest the template. Never shown.
      Write them in your language, lower case; accents don't matter. A keyword matches whole
      words only. Use * for "any letters": "quiz*" matches "quizzes", "*room" matches "bedroom",
      "*toets*" matches "biologietoetsen". Phrases ("learn for") are fine. Translate the idea,
      not word for word, and add the words people really use: the number of keywords may differ
      per language.
    - *_steps: the suggested steps, in order. Each step is small, concrete and starts with a verb.
      The user can untick or edit every step before adding it.
-->
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Template name. -->
    <string name="template_study_test_name">Study for a test</string>
    <string-array name="template_study_test_keywords" tools:ignore="InconsistentArrays">
        <item>test</item>
        <item>tests</item>
        <item>exam</item>
        <item>exams</item>
        <item>quiz*</item>
        <item>revis*</item>
        <item>study</item>
        <item>studying</item>
        <item>learn for</item>
    </string-array>
    <string-array name="template_study_test_steps">
        <item>Find out which topics the test covers</item>
        <item>Gather your notes and books</item>
        <item>Review the first topic</item>
        <item>Make flashcards or a short summary</item>
        <item>Test yourself on what\'s still hard</item>
    </string-array>

    <!-- Template name. -->
    <string name="template_write_text_name">Write an essay or report</string>
    <string-array name="template_write_text_keywords" tools:ignore="InconsistentArrays">
        <item>essay*</item>
        <item>report*</item>
        <item>paper</item>
        <item>write</item>
        <item>writing</item>
    </string-array>
    <string-array name="template_write_text_steps">
        <item>Reread the assignment</item>
        <item>Collect ideas and sources</item>
        <item>Make a short outline</item>
        <item>Write a rough first version</item>
        <item>Read it through and fix what stands out</item>
        <item>Hand it in</item>
    </string-array>

