        <item>talk</item>
        <item>speech</item>
        <item>slides</item>
        <item>powerpoint</item>
    </string-array>
    <string-array name="template_presentation_steps">
        <item>Pick your main message</item>
        <item>Collect the information you need</item>
        <item>Make the slides or notes</item>
        <item>Practise it out loud once</item>
        <item>Check what you need on the day</item>
    </string-array>

