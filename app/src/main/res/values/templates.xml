    </string-array>
    <string-array name="template_homework_steps">
        <item>Check what\'s due and where to find it</item>
        <item>Get your things ready</item>
        <item>Do the first exercise</item>
        <item>Do the rest</item>
        <item>Put it in your bag</item>
    </string-array>

    <!-- Template name. -->
